# Copy to api/.env for local development. Never commit real secrets.
DJANGO_SECRET_KEY=local-dev-only-change-me
# The running app uses the restricted role. Run `manage.py migrate` with DATABASE_URL set to the owner URL below.
DATABASE_URL=postgres://greenlit_app:greenlit_app@localhost:5432/greenlit
# Owner URL, for migrations only: postgres://greenlit_owner:greenlit_owner@localhost:5432/greenlit
REDIS_URL=redis://localhost:6379/0
# Rate-limit counters (staging and production). Local development uses in-process memory instead.
CACHE_URL=redis://localhost:6379/1
# Number of trusted proxies in front of Django. Leave 0 unless one is configured.
NUM_PROXIES=0

# Sign-in (docs/sign-in.md)
# Required outside development. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEYS=
# From a Google Cloud OAuth client; sign-in with Google does not work until these are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Roles that must set up an authenticator app before using an organisation.
ENFORCE_MFA_ROLES=owner,admin

# Files (docs/files.md). Development uses local storage and the stub scanner.
FILE_STORAGE_BACKEND=local
MALWARE_SCANNER=stub
# Staging and production:
# FILE_STORAGE_BACKEND=s3
# FILE_STORAGE_BUCKET=
# FILE_STORAGE_ENDPOINT=
# FILE_STORAGE_REGION=
# FILE_STORAGE_ACCESS_KEY=
# FILE_STORAGE_SECRET_KEY=
# MALWARE_SCANNER=clamav
# CLAMAV_HOST=
# CLAMAV_PORT=3310
